    "guard:customers": "psql \"postgresql://postgres:***@127.0.0.1:54522/postgres\" -v ON_ERROR_STOP=1 -f scripts/guards/customers-security.sql",
    "guard:auth": "psql \"postgresql://postgres:***@127.0.0.1:54522/postgres\" -v ON_ERROR_STOP=1 -f scripts/guards/auth-lifecycle-security.sql",
    "guard:copilot": "psql \"postgresql://postgres:***@127.0.0.1:54522/postgres\" -v ON_ERROR_STOP=1 -f scripts/guards/cap-vg1-offline-degrade.sql",
