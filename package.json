    "guard:copilot:rls": "psql \"postgresql://postgres:***@127.0.0.1:54522/postgres\" -v ON_ERROR_STOP=1 -f scripts/guards/cap-vg1-rls-passthrough.sql",
    "guard:copilot:money": "psql \"postgresql://postgres:***@127.0.0.1:54522/postgres\" -v ON_ERROR_STOP=1 -f scripts/guards/cap-vg1-money-immutability.sql",
    "guard:copilot:bypass": "psql \"postgresql://postgres:***@127.0.0.1:54522/postgres\" -v ON_ERROR_STOP=1 -f scripts/guards/cap-vg1-no-bypass.sql",
    "guard:drift": "node scripts/guards/check-drift.mjs"
