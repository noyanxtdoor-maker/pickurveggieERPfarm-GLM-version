{
  "name": "pick-ur-veggie-erp-v3",
  "private": true,
  "version": "3.0.0-dev.0",
  "description": "PickUrVeggie ERP V3 — enterprise multi-company, multi-branch agricultural ERP (offline-first; Supabase). Governing architecture: docs/28_Enterprise_Architecture_Audit.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "guard:static": "node scripts/guards/static-guards.mjs",
    "guard:db": "psql \"postgresql://postgres:postgres@127.0.0.1:54522/postgres\" -v ON_ERROR_STOP=1 -f scripts/guards/db-guards.sql",
    "guard:rls": "psql \"postgresql://postgres:postgres@127.0.0.1:54522/postgres\" -v ON_ERROR_STOP=1 -f scripts/guards/rls-behavior.sql",
