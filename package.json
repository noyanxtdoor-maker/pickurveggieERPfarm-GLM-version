    "guard:crop": "psql \"postgresql://postgres:postgres@127.0.0.1:54522/postgres\" -v ON_ERROR_STOP=1 -f scripts/guards/crop-security.sql",
    "guard:inventory": "psql \"postgresql://postgres:postgres@127.0.0.1:54522/postgres\" -v ON_ERROR_STOP=1 -f scripts/guards/inventory-security.sql",
    "guard:pos": "psql \"postgresql://postgres:postgres@127.0.0.1:54522/postgres\" -v ON_ERROR_STOP=1 -f scripts/guards/pos-security.sql",
    "guard:accounting": "psql \"postgresql://postgres:postgres@127.0.0.1:54522/postgres\" -v ON_ERROR_STOP=1 -f scripts/guards/accounting-security.sql",
    "guard:payroll": "psql \"postgresql://postgres:postgres@127.0.0.1:54522/postgres\" -v ON_ERROR_STOP=1 -f scripts/guards/payroll-security.sql",
